# dependencies
node_modules/

# package managers: package-lock.json is the committed lockfile (npm is the
# reference path). Contributors who prefer pnpm/yarn may generate a local
# lockfile; it is not committed, so two lockfiles can never drift apart (#210).
pnpm-lock.yaml
yarn.lock

# npm pack output
*.tgz

# run artifacts produced by the plugin itself
.pi-subagents/

# local scratch
*.log
.DS_Store

# local pi settings/credentials (contains auth.json — never commit)
.pi/

# QA hunting round evidence (repros are inlined in the issues)
.qa-hunt/

# transient agent handoff notes (not part of the package)
STATE.md

# agent reports are not stored in the repo
reports/
.pi-reports/

# TUI QA 证据产物（playbook §7）
test/tui/artifacts/

# crash dumps from container runs
core

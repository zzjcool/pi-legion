{
  "models": [
    {
      "id": "flash",
      "name": "XM Flash"
    }
  ],
  "rules": [
    {
      "name": "a1-turn0-scout-recon-cannot-cross-a-host",
      "when": {
        "turnIndex": 0
      },
      "then": {
        "type": "tool_call",
        "name": "vexillatio",
        "arguments": {
          "agent": "scout",
          "task": "XM_A1_PROBE — this recon dispatch must be refused: a utility child cannot cross machines",
          "host": "{{HOST}}",
          "hostCwd": "{{HOST_CWD}}"
        }
      }
    },
    {
      "name": "a1-turn1-echo-the-tool-result-verbatim",
      "when": {
        "turnIndex": 1
      },
      "then": {
        "type": "text",
        "content": "A1_TOOL_RESULT {{lastToolContent}}"
      }
    },
    {
      "name": "catch-all-final-text",
      "then": {
        "type": "text",
        "content": "A1_TOOL_RESULT (extra turn; earlier text above)"
      }
    }
  ]
}
